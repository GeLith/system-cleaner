{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "系统清理助手",
  "version": "1.0.0",
  "identifier": "com.opencode.systemcleaner",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "系统清理助手",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": true,
        "center": true,
        "backgroundColor": "#F5F7FA",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SystemCleaner Project",
    "copyright": "Copyright © 2026 SystemCleaner Project",
    "category": "Utility",
    "resources": {
      "../src/ui/rules/*": "rules/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
